# Cursor Ignore File
# Files and directories that should be excluded from Cursor's indexing

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# UV cache (but keep uv.lock for context)
.uv_cache/

# Testing artifacts
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/
htmlcov/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff cache
.ruff_cache/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation builds
site/
docs/_build/

# Temporary files
*.tmp
*.bak
*.swp

# OS files
.DS_Store
Thumbs.db

# Generated projects (if any test projects exist)
test-*/
tmp-*/

